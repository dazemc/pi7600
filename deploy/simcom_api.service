[Unit]
Description=Simcom API (SIM7600 modem service)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=simcom_api
Group=simcom_api
SupplementaryGroups=dialout video
WorkingDirectory=/opt/simcom_api
EnvironmentFile=/etc/simcom_api/simcom_api.env
ExecStart=/opt/simcom_api/bin/main --apply-migrations
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Hardening. Keep device access available for the modem and camera.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/simcom_api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
# Allow the status endpoint's `ping` subprocess to open ICMP sockets.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
