# Copy to /etc/pi7600/pi7600.env and adjust for the host.

# Serverpod run mode. Production loads config/production.yaml.
SERVERPOD_RUN_MODE=production

# PostgreSQL password for the `pi7600` database user.
SERVERPOD_DATABASE_PASSWORD=change-me

# Debian's libserialport0 package ships libserialport.so.0 but not the
# unversioned libserialport.so symlink that the Dart FFI loader looks for by
# default. Point it at the versioned library name instead.
LIBSERIALPORT_PATH=libserialport.so.0

# Modem serial port.
PI7600_AT_COM=/dev/ttyUSB2
PI7600_AT_BAUDRATE=115200
PI7600_AT_TIMEOUT=10

# Camera. Leave PI7600_CAMERA_DEVICE unset to probe /dev/video0../dev/video31.
# PI7600_CAMERA_DEVICE=/dev/video0
PI7600_CAMERA_FPS=15
PI7600_CAMERA_WIDTH=640
PI7600_CAMERA_HEIGHT=480

# JWT keys. Generate with openssl (see README) and keep them out of git.
PI7600_JWT_PRIVATE_KEY_PATH=/etc/pi7600/keys/private.pem
PI7600_JWT_PUBLIC_KEY_PATH=/etc/pi7600/keys/public.pem
PI7600_JWT_ISSUER=pi.daazed.dev
PI7600_JWT_EXPIRE_MINUTES=30

# WebSocket authentication timeout in seconds.
PI7600_WEBSOCKET_AUTH_TIMEOUT=5

# Status checks.
PI7600_PING_INTERFACE=usb0
PI7600_PING_TARGETS=1.1.1.1,www.google.com

# Optional facial recognition. Models are loaded from these paths; leave the
# defaults when the models are not installed (recognition stays disabled).
# PI7600_FACE_DETECTOR_MODEL=/opt/pi7600/ml/face_detection_yunet_2023mar_int8bq.onnx
# PI7600_FACE_RECOGNIZER_MODEL=/opt/pi7600/ml/face_recognition_sface_2021dec.onnx
# PI7600_FACE_EMBEDDINGS_DIR=/var/lib/pi7600/embeddings
# PI7600_FACE_MATCH_THRESHOLD=0.363

PI7600_LOG_LEVEL=INFO
