# Copy to /etc/simcom_api/simcom_api.env and adjust for the host.

# Serverpod run mode. Production loads config/production.yaml.
SERVERPOD_RUN_MODE=production

# PostgreSQL password for the `simcom_api` database user.
SERVERPOD_DATABASE_PASSWORD=change-me

# Debian's libserialport0 package ships libserialport.so.0 but not the
# unversioned libserialport.so symlink that the Dart FFI loader looks for by
# default. Point it at the versioned library name instead.
LIBSERIALPORT_PATH=libserialport.so.0

# Modem serial port. Use /dev/simcom-at with deploy/99-simcom-at.rules
# when ttyUSB numbering is unstable across resets.
SIMCOM_API_AT_COM=/dev/ttyUSB2
SIMCOM_API_AT_BAUDRATE=115200
SIMCOM_API_AT_TIMEOUT=10

# Camera. Leave SIMCOM_API_CAMERA_DEVICE unset to probe /dev/video0../dev/video31.
# SIMCOM_API_CAMERA_DEVICE=/dev/video0
SIMCOM_API_CAMERA_FPS=15
SIMCOM_API_CAMERA_WIDTH=640
SIMCOM_API_CAMERA_HEIGHT=480

# JWT keys. Generate with openssl (see README) and keep them out of git.
SIMCOM_API_JWT_PRIVATE_KEY_PATH=/etc/simcom_api/keys/private.pem
SIMCOM_API_JWT_PUBLIC_KEY_PATH=/etc/simcom_api/keys/public.pem
SIMCOM_API_JWT_ISSUER=pi.daazed.dev
SIMCOM_API_JWT_EXPIRE_MINUTES=30

# WebSocket authentication timeout in seconds.
SIMCOM_API_WEBSOCKET_AUTH_TIMEOUT=5

# Status checks.
SIMCOM_API_PING_INTERFACE=usb0
SIMCOM_API_PING_TARGETS=1.1.1.1,www.google.com

# Interactive API explorer at /docs and the OpenAPI schema at /openapi.json.
# Set to false to stop serving both routes and their static assets.
SIMCOM_API_DOCS_ENABLED=true

# Optional facial recognition. Models are loaded from these paths; leave the
# defaults when the models are not installed (recognition stays disabled).
# SIMCOM_API_FACE_DETECTOR_MODEL=/opt/simcom_api/ml/face_detection_yunet_2023mar_int8bq.onnx
# SIMCOM_API_FACE_RECOGNIZER_MODEL=/opt/simcom_api/ml/face_recognition_sface_2021dec.onnx
# SIMCOM_API_FACE_EMBEDDINGS_DIR=/var/lib/simcom_api/embeddings
# SIMCOM_API_FACE_MATCH_THRESHOLD=0.363

SIMCOM_API_LOG_LEVEL=INFO
