# Local development settings. Copy to .env and adjust as needed.
PI7600_DATABASE_URL=sqlite+aiosqlite:///./cmgl.db
PI7600_AT_COM=/dev/ttyUSB2
PI7600_AT_BAUDRATE=115200
PI7600_AT_TIMEOUT=10
PI7600_CAMERA_INDEX=-1
PI7600_CAMERA_FPS=15
PI7600_FACE_DETECTOR_MODEL=./ml/face_detection_yunet_2023mar_int8bq.onnx
PI7600_FACE_RECOGNIZER_MODEL=./ml/face_recognition_sface_2021dec.onnx
PI7600_FACE_EMBEDDINGS_DIR=./data/embeddings
PI7600_FACE_MATCH_THRESHOLD=0.363
PI7600_JWT_PRIVATE_KEY_PATH=.keys/private.pem
PI7600_JWT_PUBLIC_KEY_PATH=.keys/public.pem
PI7600_JWT_ISSUER=pi.daazed.dev
PI7600_JWT_EXPIRE_MINUTES=30
PI7600_WEBSOCKET_AUTH_TIMEOUT=5
PI7600_LOG_LEVEL=INFO
